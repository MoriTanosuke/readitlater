# Kopieren nach .env und anpassen.

# GitHub-Repository in Kleinbuchstaben: Benutzer/Repository (bestimmt den Image-Namen)
GITHUB_REPO=owner/repo

# Name des Docker-Netzwerks, in dem auch dein Caddy-Container hängt
PROXY_NETWORK=proxy

# Darf sich jemand neu registrieren? Nach dem Anlegen der eigenen Konten auf false stellen.
REGISTRATION_ENABLED=true

# Die Seite sollte über HTTPS (Caddy) ausgeliefert werden. Nur ohne HTTPS auf false.
COOKIE_SECURE=true

# Passkeys: Adresse, unter der die App erreichbar ist (mit https://, ohne Pfad). Ohne Angabe sind
# Passkeys aus. ACHTUNG: Passkeys sind an die Domain gebunden. Wird sie später geändert, funktionieren
# alle eingerichteten Passkeys nicht mehr (das Passwort geht weiter).
PASSKEY_ORIGIN=https://lesen.example.org
# Optional: Domain, an die Passkeys gebunden sind. Standard ist der Host aus PASSKEY_ORIGIN.
# Nur setzen, wenn Passkeys auch für übergeordnete Domain gelten sollen (z. B. example.org).
# PASSKEY_RP_ID=

# Log-Level des Backends
RUST_LOG=info
