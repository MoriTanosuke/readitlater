# Kopieren nach .env und anpassen.

# GitHub-Repository in Kleinbuchstaben: Benutzer/Repository (bestimmt den Image-Namen)
GITHUB_REPO=owner/repo

# Name des Docker-Netzwerks, in dem auch dein Caddy-Container hängt
PROXY_NETWORK=proxy

# Darf sich jemand neu registrieren? Nach dem Anlegen der eigenen Konten auf false stellen.
REGISTRATION_ENABLED=true

# Die Seite sollte über HTTPS (Caddy) ausgeliefert werden. Nur ohne HTTPS auf false.
COOKIE_SECURE=true

# Log-Level des Backends
RUST_LOG=info
