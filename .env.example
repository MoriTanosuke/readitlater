# Kopieren nach .env und anpassen.

# GitHub-Repository in Kleinbuchstaben: Benutzer/Repository (bestimmt die Image-Namen)
GITHUB_REPO=owner/repo

# Port, unter dem die App auf dem Server erreichbar ist
WEB_PORT=8080

# Darf sich jemand neu registrieren? Nach dem Anlegen der eigenen Konten auf false stellen.
REGISTRATION_ENABLED=true

# Nur auf true setzen, wenn die Seite über HTTPS ausgeliefert wird.
COOKIE_SECURE=false

# Optional: Domain für automatisches HTTPS durch Caddy (Port 80 und 443 freigeben)
# SITE_ADDRESS=lesen.example.org

# Log-Level des Backends
RUST_LOG=info
